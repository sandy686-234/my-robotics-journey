; Heterogeneous Multi-Robot Task Allocation via SMT
(set-logic QF_LIRA)
(set-option :produce-models true)
(set-option :produce-unsat-cores true)
(set-option :pp.decimal true)

; === Decision Variables ===

; Start times for each task
(declare-const s_pickup_shelfA Real)
(assert (>= s_pickup_shelfA 0.0))
(declare-const s_pickup_shelfB Real)
(assert (>= s_pickup_shelfB 0.0))
(declare-const s_delivery_packing Real)
(assert (>= s_delivery_packing 0.0))
(declare-const s_delivery_dock Real)
(assert (>= s_delivery_dock 0.0))
(declare-const s_quality_inspect Real)
(assert (>= s_quality_inspect 0.0))
(declare-const s_battery_charge Real)
(assert (>= s_battery_charge 0.0))

; Assignment variables: assign_<task>_<robot> = 1 if assigned
(declare-const assign_pickup_shelfA_A Int)
(assert (or (= assign_pickup_shelfA_A 0) (= assign_pickup_shelfA_A 1)))
(declare-const assign_pickup_shelfA_B Int)
(assert (or (= assign_pickup_shelfA_B 0) (= assign_pickup_shelfA_B 1)))
(declare-const assign_pickup_shelfA_C Int)
(assert (or (= assign_pickup_shelfA_C 0) (= assign_pickup_shelfA_C 1)))
(declare-const assign_pickup_shelfB_A Int)
(assert (or (= assign_pickup_shelfB_A 0) (= assign_pickup_shelfB_A 1)))
(declare-const assign_pickup_shelfB_B Int)
(assert (or (= assign_pickup_shelfB_B 0) (= assign_pickup_shelfB_B 1)))
(declare-const assign_pickup_shelfB_C Int)
(assert (or (= assign_pickup_shelfB_C 0) (= assign_pickup_shelfB_C 1)))
(declare-const assign_delivery_packing_A Int)
(assert (or (= assign_delivery_packing_A 0) (= assign_delivery_packing_A 1)))
(declare-const assign_delivery_packing_B Int)
(assert (or (= assign_delivery_packing_B 0) (= assign_delivery_packing_B 1)))
(declare-const assign_delivery_packing_C Int)
(assert (or (= assign_delivery_packing_C 0) (= assign_delivery_packing_C 1)))
(declare-const assign_delivery_dock_A Int)
(assert (or (= assign_delivery_dock_A 0) (= assign_delivery_dock_A 1)))
(declare-const assign_delivery_dock_B Int)
(assert (or (= assign_delivery_dock_B 0) (= assign_delivery_dock_B 1)))
(declare-const assign_delivery_dock_C Int)
(assert (or (= assign_delivery_dock_C 0) (= assign_delivery_dock_C 1)))
(declare-const assign_quality_inspect_A Int)
(assert (or (= assign_quality_inspect_A 0) (= assign_quality_inspect_A 1)))
(declare-const assign_quality_inspect_B Int)
(assert (or (= assign_quality_inspect_B 0) (= assign_quality_inspect_B 1)))
(declare-const assign_quality_inspect_C Int)
(assert (or (= assign_quality_inspect_C 0) (= assign_quality_inspect_C 1)))
(declare-const assign_battery_charge_A Int)
(assert (or (= assign_battery_charge_A 0) (= assign_battery_charge_A 1)))
(declare-const assign_battery_charge_B Int)
(assert (or (= assign_battery_charge_B 0) (= assign_battery_charge_B 1)))
(declare-const assign_battery_charge_C Int)
(assert (or (= assign_battery_charge_C 0) (= assign_battery_charge_C 1)))

; Ordering variables: order_<t1>_<t2>_<robot> = 1 if t1 before t2
(declare-const order_pickup_shelfA_pickup_shelfB_A Int)
(assert (or (= order_pickup_shelfA_pickup_shelfB_A 0) (= order_pickup_shelfA_pickup_shelfB_A 1)))
(declare-const order_pickup_shelfA_delivery_packing_A Int)
(assert (or (= order_pickup_shelfA_delivery_packing_A 0) (= order_pickup_shelfA_delivery_packing_A 1)))
(declare-const order_pickup_shelfA_delivery_dock_A Int)
(assert (or (= order_pickup_shelfA_delivery_dock_A 0) (= order_pickup_shelfA_delivery_dock_A 1)))
(declare-const order_pickup_shelfA_quality_inspect_A Int)
(assert (or (= order_pickup_shelfA_quality_inspect_A 0) (= order_pickup_shelfA_quality_inspect_A 1)))
(declare-const order_pickup_shelfA_battery_charge_A Int)
(assert (or (= order_pickup_shelfA_battery_charge_A 0) (= order_pickup_shelfA_battery_charge_A 1)))
(declare-const order_pickup_shelfB_delivery_packing_A Int)
(assert (or (= order_pickup_shelfB_delivery_packing_A 0) (= order_pickup_shelfB_delivery_packing_A 1)))
(declare-const order_pickup_shelfB_delivery_dock_A Int)
(assert (or (= order_pickup_shelfB_delivery_dock_A 0) (= order_pickup_shelfB_delivery_dock_A 1)))
(declare-const order_pickup_shelfB_quality_inspect_A Int)
(assert (or (= order_pickup_shelfB_quality_inspect_A 0) (= order_pickup_shelfB_quality_inspect_A 1)))
(declare-const order_pickup_shelfB_battery_charge_A Int)
(assert (or (= order_pickup_shelfB_battery_charge_A 0) (= order_pickup_shelfB_battery_charge_A 1)))
(declare-const order_delivery_packing_delivery_dock_A Int)
(assert (or (= order_delivery_packing_delivery_dock_A 0) (= order_delivery_packing_delivery_dock_A 1)))
(declare-const order_delivery_packing_quality_inspect_A Int)
(assert (or (= order_delivery_packing_quality_inspect_A 0) (= order_delivery_packing_quality_inspect_A 1)))
(declare-const order_delivery_packing_battery_charge_A Int)
(assert (or (= order_delivery_packing_battery_charge_A 0) (= order_delivery_packing_battery_charge_A 1)))
(declare-const order_delivery_dock_quality_inspect_A Int)
(assert (or (= order_delivery_dock_quality_inspect_A 0) (= order_delivery_dock_quality_inspect_A 1)))
(declare-const order_delivery_dock_battery_charge_A Int)
(assert (or (= order_delivery_dock_battery_charge_A 0) (= order_delivery_dock_battery_charge_A 1)))
(declare-const order_quality_inspect_battery_charge_A Int)
(assert (or (= order_quality_inspect_battery_charge_A 0) (= order_quality_inspect_battery_charge_A 1)))
(declare-const order_pickup_shelfA_pickup_shelfB_B Int)
(assert (or (= order_pickup_shelfA_pickup_shelfB_B 0) (= order_pickup_shelfA_pickup_shelfB_B 1)))
(declare-const order_pickup_shelfA_delivery_packing_B Int)
(assert (or (= order_pickup_shelfA_delivery_packing_B 0) (= order_pickup_shelfA_delivery_packing_B 1)))
(declare-const order_pickup_shelfA_delivery_dock_B Int)
(assert (or (= order_pickup_shelfA_delivery_dock_B 0) (= order_pickup_shelfA_delivery_dock_B 1)))
(declare-const order_pickup_shelfA_quality_inspect_B Int)
(assert (or (= order_pickup_shelfA_quality_inspect_B 0) (= order_pickup_shelfA_quality_inspect_B 1)))
(declare-const order_pickup_shelfA_battery_charge_B Int)
(assert (or (= order_pickup_shelfA_battery_charge_B 0) (= order_pickup_shelfA_battery_charge_B 1)))
(declare-const order_pickup_shelfB_delivery_packing_B Int)
(assert (or (= order_pickup_shelfB_delivery_packing_B 0) (= order_pickup_shelfB_delivery_packing_B 1)))
(declare-const order_pickup_shelfB_delivery_dock_B Int)
(assert (or (= order_pickup_shelfB_delivery_dock_B 0) (= order_pickup_shelfB_delivery_dock_B 1)))
(declare-const order_pickup_shelfB_quality_inspect_B Int)
(assert (or (= order_pickup_shelfB_quality_inspect_B 0) (= order_pickup_shelfB_quality_inspect_B 1)))
(declare-const order_pickup_shelfB_battery_charge_B Int)
(assert (or (= order_pickup_shelfB_battery_charge_B 0) (= order_pickup_shelfB_battery_charge_B 1)))
(declare-const order_delivery_packing_delivery_dock_B Int)
(assert (or (= order_delivery_packing_delivery_dock_B 0) (= order_delivery_packing_delivery_dock_B 1)))
(declare-const order_delivery_packing_quality_inspect_B Int)
(assert (or (= order_delivery_packing_quality_inspect_B 0) (= order_delivery_packing_quality_inspect_B 1)))
(declare-const order_delivery_packing_battery_charge_B Int)
(assert (or (= order_delivery_packing_battery_charge_B 0) (= order_delivery_packing_battery_charge_B 1)))
(declare-const order_delivery_dock_quality_inspect_B Int)
(assert (or (= order_delivery_dock_quality_inspect_B 0) (= order_delivery_dock_quality_inspect_B 1)))
(declare-const order_delivery_dock_battery_charge_B Int)
(assert (or (= order_delivery_dock_battery_charge_B 0) (= order_delivery_dock_battery_charge_B 1)))
(declare-const order_quality_inspect_battery_charge_B Int)
(assert (or (= order_quality_inspect_battery_charge_B 0) (= order_quality_inspect_battery_charge_B 1)))
(declare-const order_pickup_shelfA_pickup_shelfB_C Int)
(assert (or (= order_pickup_shelfA_pickup_shelfB_C 0) (= order_pickup_shelfA_pickup_shelfB_C 1)))
(declare-const order_pickup_shelfA_delivery_packing_C Int)
(assert (or (= order_pickup_shelfA_delivery_packing_C 0) (= order_pickup_shelfA_delivery_packing_C 1)))
(declare-const order_pickup_shelfA_delivery_dock_C Int)
(assert (or (= order_pickup_shelfA_delivery_dock_C 0) (= order_pickup_shelfA_delivery_dock_C 1)))
(declare-const order_pickup_shelfA_quality_inspect_C Int)
(assert (or (= order_pickup_shelfA_quality_inspect_C 0) (= order_pickup_shelfA_quality_inspect_C 1)))
(declare-const order_pickup_shelfA_battery_charge_C Int)
(assert (or (= order_pickup_shelfA_battery_charge_C 0) (= order_pickup_shelfA_battery_charge_C 1)))
(declare-const order_pickup_shelfB_delivery_packing_C Int)
(assert (or (= order_pickup_shelfB_delivery_packing_C 0) (= order_pickup_shelfB_delivery_packing_C 1)))
(declare-const order_pickup_shelfB_delivery_dock_C Int)
(assert (or (= order_pickup_shelfB_delivery_dock_C 0) (= order_pickup_shelfB_delivery_dock_C 1)))
(declare-const order_pickup_shelfB_quality_inspect_C Int)
(assert (or (= order_pickup_shelfB_quality_inspect_C 0) (= order_pickup_shelfB_quality_inspect_C 1)))
(declare-const order_pickup_shelfB_battery_charge_C Int)
(assert (or (= order_pickup_shelfB_battery_charge_C 0) (= order_pickup_shelfB_battery_charge_C 1)))
(declare-const order_delivery_packing_delivery_dock_C Int)
(assert (or (= order_delivery_packing_delivery_dock_C 0) (= order_delivery_packing_delivery_dock_C 1)))
(declare-const order_delivery_packing_quality_inspect_C Int)
(assert (or (= order_delivery_packing_quality_inspect_C 0) (= order_delivery_packing_quality_inspect_C 1)))
(declare-const order_delivery_packing_battery_charge_C Int)
(assert (or (= order_delivery_packing_battery_charge_C 0) (= order_delivery_packing_battery_charge_C 1)))
(declare-const order_delivery_dock_quality_inspect_C Int)
(assert (or (= order_delivery_dock_quality_inspect_C 0) (= order_delivery_dock_quality_inspect_C 1)))
(declare-const order_delivery_dock_battery_charge_C Int)
(assert (or (= order_delivery_dock_battery_charge_C 0) (= order_delivery_dock_battery_charge_C 1)))
(declare-const order_quality_inspect_battery_charge_C Int)
(assert (or (= order_quality_inspect_battery_charge_C 0) (= order_quality_inspect_battery_charge_C 1)))

; Makespan variable
(declare-const makespan Real)
(assert (>= makespan 0.0))

; === Constraints ===

; C1: Each task assigned to exactly one robot
(assert (= (+ assign_pickup_shelfA_A assign_pickup_shelfA_B assign_pickup_shelfA_C) 1))
(assert (= (+ assign_pickup_shelfB_A assign_pickup_shelfB_B assign_pickup_shelfB_C) 1))
(assert (= (+ assign_delivery_packing_A assign_delivery_packing_B assign_delivery_packing_C) 1))
(assert (= (+ assign_delivery_dock_A assign_delivery_dock_B assign_delivery_dock_C) 1))
(assert (= (+ assign_quality_inspect_A assign_quality_inspect_B assign_quality_inspect_C) 1))
(assert (= (+ assign_battery_charge_A assign_battery_charge_B assign_battery_charge_C) 1))

; C2: Capability constraints
(assert (= assign_pickup_shelfA_B 0))
(assert (= assign_pickup_shelfA_C 0))
(assert (= assign_pickup_shelfB_B 0))
(assert (= assign_pickup_shelfB_C 0))
(assert (= assign_quality_inspect_A 0))
(assert (= assign_quality_inspect_B 0))

; C3: Maximum tasks per robot
(assert (<= (+ assign_pickup_shelfA_A assign_pickup_shelfB_A assign_delivery_packing_A assign_delivery_dock_A assign_quality_inspect_A assign_battery_charge_A) 3))
(assert (<= (+ assign_pickup_shelfA_B assign_pickup_shelfB_B assign_delivery_packing_B assign_delivery_dock_B assign_quality_inspect_B assign_battery_charge_B) 4))
(assert (<= (+ assign_pickup_shelfA_C assign_pickup_shelfB_C assign_delivery_packing_C assign_delivery_dock_C assign_quality_inspect_C assign_battery_charge_C) 3))

; C4: Tasks on same robot must not overlap (with travel time)
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_pickup_shelfB_A 1) (= order_pickup_shelfA_pickup_shelfB_A 1)) (>= s_pickup_shelfB (+ s_pickup_shelfA 15.00 2.24))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_pickup_shelfB_A 1) (= order_pickup_shelfA_pickup_shelfB_A 0)) (>= s_pickup_shelfA (+ s_pickup_shelfB 18.00 2.24))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_delivery_packing_A 1) (= order_pickup_shelfA_delivery_packing_A 1)) (>= s_delivery_packing (+ s_pickup_shelfA 15.00 4.47))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_delivery_packing_A 1) (= order_pickup_shelfA_delivery_packing_A 0)) (>= s_pickup_shelfA (+ s_delivery_packing 20.00 4.47))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_delivery_dock_A 1) (= order_pickup_shelfA_delivery_dock_A 1)) (>= s_delivery_dock (+ s_pickup_shelfA 15.00 8.25))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_delivery_dock_A 1) (= order_pickup_shelfA_delivery_dock_A 0)) (>= s_pickup_shelfA (+ s_delivery_dock 22.00 8.25))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_quality_inspect_A 1) (= order_pickup_shelfA_quality_inspect_A 1)) (>= s_quality_inspect (+ s_pickup_shelfA 15.00 6.08))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_quality_inspect_A 1) (= order_pickup_shelfA_quality_inspect_A 0)) (>= s_pickup_shelfA (+ s_quality_inspect 25.00 6.08))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_battery_charge_A 1) (= order_pickup_shelfA_battery_charge_A 1)) (>= s_battery_charge (+ s_pickup_shelfA 15.00 1.41))))
(assert (=> (and (= assign_pickup_shelfA_A 1) (= assign_battery_charge_A 1) (= order_pickup_shelfA_battery_charge_A 0)) (>= s_pickup_shelfA (+ s_battery_charge 30.00 1.41))))
(assert (=> (and (= assign_pickup_shelfB_A 1) (= assign_delivery_packing_A 1) (= order_pickup_shelfB_delivery_packing_A 1)) (>= s_delivery_packing (+ s_pickup_shelfB 18.00 5.00))))
(assert (=> (and (= assign_pickup_shelfB_A 1) (= assign_delivery_packing_A 1) (= order_pickup_shelfB_delivery_packing_A 0)) (>= s_pickup_shelfB (+ s_delivery_packing 20.00 5.00))))
(assert (=> (and (= assign_pickup_shelfB_A 1) (= assign_delivery_dock_A 1) (= order_pickup_shelfB_delivery_dock_A 1)) (>= s_delivery_dock (+ s_pickup_shelfB 18.00 8.06))))
(assert (=> (and (= assign_pickup_shelfB_A 1) (= assign_delivery_dock_A 1) (= order_pickup_shelfB_delivery_dock_A 0)) (>= s_pickup_shelfB (+ s_delivery_dock 22.00 8.06))))
(assert (=> (and (= assign_pickup_shelfB_A 1) (= assign_quality_inspect_A 1) (= order_pickup_shelfB_quality_inspect_A 1)) (>= s_quality_inspect (+ s_pickup_shelfB 18.00 5.10))))
(assert (=> (and (= assign_pickup_shelfB_A 1) (= assign_quality_inspect_A 1) (= order_pickup_shelfB_quality_inspect_A 0)) (>= s_pickup_shelfB (+ s_quality_inspect 25.00 5.10))))
(assert (=> (and (= assign_pickup_shelfB_A 1) (= assign_battery_charge_A 1) (= order_pickup_shelfB_battery_charge_A 1)) (>= s_battery_charge (+ s_pickup_shelfB 18.00 2.24))))
(assert (=> (and (= assign_pickup_shelfB_A 1) (= assign_battery_charge_A 1) (= order_pickup_shelfB_battery_charge_A 0)) (>= s_pickup_shelfB (+ s_battery_charge 30.00 2.24))))
(assert (=> (and (= assign_delivery_packing_A 1) (= assign_delivery_dock_A 1) (= order_delivery_packing_delivery_dock_A 1)) (>= s_delivery_dock (+ s_delivery_packing 20.00 4.00))))
(assert (=> (and (= assign_delivery_packing_A 1) (= assign_delivery_dock_A 1) (= order_delivery_packing_delivery_dock_A 0)) (>= s_delivery_packing (+ s_delivery_dock 22.00 4.00))))
(assert (=> (and (= assign_delivery_packing_A 1) (= assign_quality_inspect_A 1) (= order_delivery_packing_quality_inspect_A 1)) (>= s_quality_inspect (+ s_delivery_packing 20.00 3.61))))
(assert (=> (and (= assign_delivery_packing_A 1) (= assign_quality_inspect_A 1) (= order_delivery_packing_quality_inspect_A 0)) (>= s_delivery_packing (+ s_quality_inspect 25.00 3.61))))
(assert (=> (and (= assign_delivery_packing_A 1) (= assign_battery_charge_A 1) (= order_delivery_packing_battery_charge_A 1)) (>= s_battery_charge (+ s_delivery_packing 20.00 5.83))))
(assert (=> (and (= assign_delivery_packing_A 1) (= assign_battery_charge_A 1) (= order_delivery_packing_battery_charge_A 0)) (>= s_delivery_packing (+ s_battery_charge 30.00 5.83))))
(assert (=> (and (= assign_delivery_dock_A 1) (= assign_quality_inspect_A 1) (= order_delivery_dock_quality_inspect_A 1)) (>= s_quality_inspect (+ s_delivery_dock 22.00 3.61))))
(assert (=> (and (= assign_delivery_dock_A 1) (= assign_quality_inspect_A 1) (= order_delivery_dock_quality_inspect_A 0)) (>= s_delivery_dock (+ s_quality_inspect 25.00 3.61))))
(assert (=> (and (= assign_delivery_dock_A 1) (= assign_battery_charge_A 1) (= order_delivery_dock_battery_charge_A 1)) (>= s_battery_charge (+ s_delivery_dock 22.00 9.49))))
(assert (=> (and (= assign_delivery_dock_A 1) (= assign_battery_charge_A 1) (= order_delivery_dock_battery_charge_A 0)) (>= s_delivery_dock (+ s_battery_charge 30.00 9.49))))
(assert (=> (and (= assign_quality_inspect_A 1) (= assign_battery_charge_A 1) (= order_quality_inspect_battery_charge_A 1)) (>= s_battery_charge (+ s_quality_inspect 25.00 7.00))))
(assert (=> (and (= assign_quality_inspect_A 1) (= assign_battery_charge_A 1) (= order_quality_inspect_battery_charge_A 0)) (>= s_quality_inspect (+ s_battery_charge 30.00 7.00))))
; Initial travel from start for robot A
(assert (=> (= assign_pickup_shelfA_A 1) (>= s_pickup_shelfA 4.00)))
(assert (=> (= assign_pickup_shelfB_A 1) (>= s_pickup_shelfB 5.39)))
(assert (=> (= assign_delivery_packing_A 1) (>= s_delivery_packing 8.25)))
(assert (=> (= assign_delivery_dock_A 1) (>= s_delivery_dock 12.17)))
(assert (=> (= assign_quality_inspect_A 1) (>= s_quality_inspect 10.05)))
(assert (=> (= assign_battery_charge_A 1) (>= s_battery_charge 3.16)))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_pickup_shelfB_B 1) (= order_pickup_shelfA_pickup_shelfB_B 1)) (>= s_pickup_shelfB (+ s_pickup_shelfA 15.00 1.60))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_pickup_shelfB_B 1) (= order_pickup_shelfA_pickup_shelfB_B 0)) (>= s_pickup_shelfA (+ s_pickup_shelfB 18.00 1.60))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_delivery_packing_B 1) (= order_pickup_shelfA_delivery_packing_B 1)) (>= s_delivery_packing (+ s_pickup_shelfA 15.00 3.19))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_delivery_packing_B 1) (= order_pickup_shelfA_delivery_packing_B 0)) (>= s_pickup_shelfA (+ s_delivery_packing 20.00 3.19))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_delivery_dock_B 1) (= order_pickup_shelfA_delivery_dock_B 1)) (>= s_delivery_dock (+ s_pickup_shelfA 15.00 5.89))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_delivery_dock_B 1) (= order_pickup_shelfA_delivery_dock_B 0)) (>= s_pickup_shelfA (+ s_delivery_dock 22.00 5.89))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_quality_inspect_B 1) (= order_pickup_shelfA_quality_inspect_B 1)) (>= s_quality_inspect (+ s_pickup_shelfA 15.00 4.34))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_quality_inspect_B 1) (= order_pickup_shelfA_quality_inspect_B 0)) (>= s_pickup_shelfA (+ s_quality_inspect 25.00 4.34))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_battery_charge_B 1) (= order_pickup_shelfA_battery_charge_B 1)) (>= s_battery_charge (+ s_pickup_shelfA 15.00 1.01))))
(assert (=> (and (= assign_pickup_shelfA_B 1) (= assign_battery_charge_B 1) (= order_pickup_shelfA_battery_charge_B 0)) (>= s_pickup_shelfA (+ s_battery_charge 30.00 1.01))))
(assert (=> (and (= assign_pickup_shelfB_B 1) (= assign_delivery_packing_B 1) (= order_pickup_shelfB_delivery_packing_B 1)) (>= s_delivery_packing (+ s_pickup_shelfB 18.00 3.57))))
(assert (=> (and (= assign_pickup_shelfB_B 1) (= assign_delivery_packing_B 1) (= order_pickup_shelfB_delivery_packing_B 0)) (>= s_pickup_shelfB (+ s_delivery_packing 20.00 3.57))))
(assert (=> (and (= assign_pickup_shelfB_B 1) (= assign_delivery_dock_B 1) (= order_pickup_shelfB_delivery_dock_B 1)) (>= s_delivery_dock (+ s_pickup_shelfB 18.00 5.76))))
